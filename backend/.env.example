# Copy to backend/.env. Use a Google Cloud OAuth client of type Web application.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Needed by resume analysis, independently of sign-in.
GEMINI_API_KEY=

# Database configuration (leave commented for local SQLite)
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@host:port/dbname

# Rate limiting (safeguard against brute-force and server overload)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=60
SESSION_RATE_LIMIT=45
