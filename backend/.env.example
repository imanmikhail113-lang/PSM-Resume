# Copy to backend/.env. Use a Google Cloud OAuth client of type Web application.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Needed by resume analysis, independently of sign-in.
GEMINI_API_KEY=
